{
  "name": "@gaiadesk/tauri-plugin-support",
  "version": "0.4.1",
  "description": "A \"Get help\" button for your Tauri app: your customer shares your app's window with your support team on GaiaDesk, who can see it and, if you allow it, guide it. The JS side of tauri-plugin-gaiadesk-support.",
  "license": "MIT",
  "type": "module",
  "main": "./dist-js/index.js",
  "types": "./dist-js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-js/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p guest-js/tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test guest-js/test/"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.15",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaia-Desk/gaiadesk-embed-tauri.git"
  },
  "homepage": "https://github.com/Gaia-Desk/gaiadesk-embed-tauri#readme",
  "bugs": {
    "url": "https://github.com/Gaia-Desk/gaiadesk-embed-tauri/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["gaiadesk", "tauri", "tauri-plugin", "support", "remote-support", "screen-share", "cobrowse", "help-desk"]
}
